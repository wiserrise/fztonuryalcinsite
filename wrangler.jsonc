{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fztonuryalcin-site",
  // Müşterinin kendi Cloudflare hesabı (Fztonuryalcin@gmail.com's Account).
  // Açıkça yazılmazsa wrangler iki hesap arasında kayabiliyor.
  "account_id": "095977b82719e2246e277846b425352f",
  "compatibility_date": "2026-07-28",
  "assets": {
    // Vite build çıktısı
    "directory": "./dist",
    // Bütün geçerli sayfalar ön render edilip dosya olarak yazılır (scripts/prerender.mjs);
    // dosyası olmayan adres gerçekten yoktur. Önceki "single-page-application" ayarında
    // böyle adresler index.html'e düşüp 200 dönüyor ve boş sayfa açıyordu. Artık
    // dist/404.html 404 durum koduyla sunulur.
    "not_found_handling": "404-page"
  },
  // Custom domain yerine zone route: proxy'li DNS kaydında origin'e gitmeden
  // devreye girer, bu yüzden DNS kaydı değiştirmeden geçiş yapılabiliyor.
  "routes": [
    { "pattern": "fztonuryalcin.com/*", "zone_name": "fztonuryalcin.com" },
    { "pattern": "www.fztonuryalcin.com/*", "zone_name": "fztonuryalcin.com" }
  ]
}
